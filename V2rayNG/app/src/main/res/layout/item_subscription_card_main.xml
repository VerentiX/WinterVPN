<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="#1FFFFFFF"
    app:cardCornerRadius="26dp"
    app:cardElevation="0dp"
    app:strokeColor="#33FFFFFF"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/subscription_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="72dp"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="8dp"
            android:paddingBottom="10dp">

            <ImageView
                android:id="@+id/expand_icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_drop_down"
                app:tint="#C9FFFFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="2dp"
                android:paddingEnd="6dp">

                <TextView
                    android:id="@+id/subscription_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/subscription_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#8FFFFFFF"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- Soft hairline — separates title from actions without chip bubbles -->
            <View
                android:layout_width="1dp"
                android:layout_height="26dp"
                android:layout_marginEnd="2dp"
                android:background="#2EFFFFFF" />

            <ImageView
                android:id="@+id/measure_subscription"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/title_measure_subscription_delay"
                android:padding="9dp"
                android:src="@drawable/ic_speed_24dp"
                app:tint="#B8E7FF" />

            <ImageView
                android:id="@+id/update_subscription"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/title_sub_update"
                android:padding="9dp"
                android:src="@drawable/ic_refresh_24dp"
                app:tint="#D7F0FF" />

            <ImageView
                android:id="@+id/edit_subscription"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/menu_item_edit_config"
                android:padding="9dp"
                android:src="@drawable/ic_more_vert_24dp"
                app:tint="#D6FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/subscription_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_subscription_stats"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_subscription_info"
                    app:tint="#9EC4FF" />

                <FrameLayout
                    android:id="@+id/traffic_container"
                    android:layout_width="0dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1">

                    <ProgressBar
                        android:id="@+id/subscription_traffic_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:max="10000"
                        android:progressDrawable="@drawable/progress_subscription_traffic" />

                    <TextView
                        android:id="@+id/subscription_traffic_text"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:maxLines="1"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:textColor="#F2FFFFFF"
                        android:textSize="11sp" />
                </FrameLayout>

                <TextView
                    android:id="@+id/subscription_expiry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:maxLines="2"
                    android:textColor="#E0FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/packages_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/subscription_packages_header"
                android:textColor="#B8FFFFFF"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/package_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <TextView
                android:id="@+id/subscription_until"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#80FFFFFF"
                android:textSize="11sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/subscription_renew"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minHeight="40dp"
                android:text="@string/subscription_renew"
                android:textColor="#FFD180"
                android:visibility="gone"
                app:rippleColor="#33FFB74D" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/profile_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/profile_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <TextView
                android:id="@+id/show_more_profiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="14dp"
                android:textColor="#B3FFFFFF"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
